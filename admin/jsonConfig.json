{
  "i18n": true,
  "type": "panel",
  "items": {
    "protocol": {
      "type": "select",
      "options": [
        {
          "label": "CoAP",
          "value": "coap"
        },
        {
          "label": "HTTP",
          "value": "http"
        },
        {
          "label": "Philips Cloud",
          "value": "cloud"
        }
      ],
      "noTranslation": true,
      "label": "Communication protocol",
      "default": "coap",
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "host": {
      "type": "text",
      "label": "Device IP or hostname",
      "validator": "data.protocol === 'cloud' || (!!data.host && /^[a-zA-Z0-9]([a-zA-Z0-9.\\-]*[a-zA-Z0-9])?$/.test(data.host))",
      "validatorErrorText": "Enter a valid IP address or hostname (no http://, no spaces)",
      "validatorNoSaveOnError": true,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "hidden": "data.protocol === 'cloud'"
    },
    "model": {
      "type": "select",
      "options": [
        {
          "label": "AC2889",
          "value": "AC2889"
        },
        {
          "label": "AC3221",
          "value": "AC3221"
        },
        {
          "label": "CX3550",
          "value": "CX3550"
        },
        {
          "label": "CX7550",
          "value": "CX7550"
        },
        {
          "label": "Generic",
          "value": "Generic"
        }
      ],
      "noTranslation": true,
      "label": "Device model",
      "help": "Selects which controls are created for your device. Choose \"Generic\" if your model is not listed (read-only, no controls).",
      "default": "Generic",
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "hidden": "data.protocol === 'cloud'"
    },
    "aliveTimeout": {
      "newLine": true,
      "type": "number",
      "label": "Alive timeout",
      "help": "ms",
      "default": 30000,
      "min": 1000,
      "max": 600000,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "hidden": "data.protocol === 'cloud'"
    },
    "reconnectInterval": {
      "type": "number",
      "label": "Reconnect interval",
      "help": "ms - should be >= Alive timeout",
      "default": 30000,
      "min": 1000,
      "max": 600000,
      "validator": "data.reconnectInterval >= data.aliveTimeout",
      "validatorErrorText": "Reconnect interval should be at least the Alive timeout",
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "hidden": "data.protocol === 'cloud'"
    },
    "_cloudHelp": {
      "type": "staticText",
      "label": "Save cloud protocol and country, then start the instance. Enter your account email, request a code and confirm the email code here. Email and code are not saved. All account devices are discovered automatically.",
      "hidden": "data.protocol !== 'cloud'",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12,
      "newLine": true
    },
    "cloudCountry": {
      "type": "text",
      "label": "Cloud account country (two letters)",
      "default": "",
      "maxLength": 2,
      "validator": "data.protocol !== 'cloud' || /^[A-Za-z]{2}$/.test(data.cloudCountry)",
      "validatorErrorText": "Enter a two-letter country code",
      "hidden": "data.protocol !== 'cloud'",
      "xs": 12,
      "md": 4,
      "sm": 12,
      "lg": 4,
      "xl": 4,
      "validatorNoSaveOnError": true,
      "newLine": true
    },
    "_cloudEmail": {
      "type": "text",
      "label": "Cloud account email",
      "maxLength": 254,
      "hidden": "data.protocol !== 'cloud'",
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "newLine": true
    },
    "_cloudRequestCode": {
      "type": "sendTo",
      "label": "Send verification code",
      "command": "cloudRequestCode",
      "jsonData": "{\"email\":${JSON.stringify(data._cloudEmail || \"\")}}",
      "showProcess": true,
      "timeout": 30000,
      "hidden": "data.protocol !== 'cloud'",
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "_cloudCode": {
      "type": "text",
      "label": "Email verification code",
      "maxLength": 6,
      "hidden": "data.protocol !== 'cloud'",
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "newLine": true
    },
    "_cloudConfirmCode": {
      "type": "sendTo",
      "label": "Confirm verification code",
      "command": "cloudConfirmCode",
      "jsonData": "{\"code\":${JSON.stringify(data._cloudCode || \"\")}}",
      "reloadBrowser": true,
      "showProcess": true,
      "timeout": 90000,
      "hidden": "data.protocol !== 'cloud'",
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "_cloudReload": {
      "type": "sendTo",
      "label": "Reload after signing in",
      "command": "cloudLoginStatus",
      "reloadBrowser": true,
      "showProcess": true,
      "timeout": 30000,
      "hidden": "data.protocol !== 'cloud'",
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "logUnknownStatesAsDebug": {
      "newLine": true,
      "type": "checkbox",
      "label": "Log unknown device attributes as debug",
      "help": "Values the adapter does not recognise are reported once per attribute at info level so they can be reported and added. Enable this to move those messages to the debug log.",
      "default": false,
      "xs": 12,
      "sm": 12,
      "md": 8,
      "lg": 8,
      "xl": 8,
      "hidden": "data.protocol === 'cloud'"
    }
  }
}
